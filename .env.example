# Copy to .env and export these in your process manager (the app does not load .env itself).
NODE_ENV=development            # production enables Secure cookies + HSTS
PORT=3000
DB=./data.db                    # SQLite file path
UPLOAD_DIR=./uploads            # must be OUTSIDE ./public; use a persistent volume in production
MAX_UPLOAD_MB=5
TRUST_PROXY=0                   # number of reverse proxies in front of the app (Render: 1)
# BACKUP_DIR=./backups          # daily database snapshot folder (newest BACKUP_KEEP=7 kept)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# --- Email (optional). Without SMTP_HOST + SMTP_FROM no email is sent and the UI says so. ---
APP_URL=http://localhost:3000   # public address for links in emails/texts; REQUIRED when SMTP_HOST is set
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0                 # 1 for port 465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Civic Repair Desk <noreply@example.com>"
# --- SMS via Twilio (optional) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111
# Only for `npm run create-admin` (never commit real values):
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
